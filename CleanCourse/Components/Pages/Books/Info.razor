@page "/books/{id:int}/info"
@using Services.Books.Models
@using Services.Books
@using Services.Metadata
@inject IBookService service
@inject IJSRuntime JSRuntime
@inject NavigationManager navigationManager

<h3>@T["课本"]</h3>
<p>@T["课本信息"]</p>

<hr class="hr" />

<div class="page">
    <div class="col-md-5">
        <label class="form-label">Id：</label>
        <span class="text-primary">@Model.BookId</span>
    </div>
    <div class="col-md-5">
        <label class="form-label">@T["书名"]</label>
        <span class="text-primary">@Model.ShortName</span>
    </div>
    <div class="col-md-5">
        <label class="form-label">@T["审核年份"]：</label>
        <span class="text-primary">@Model.AuditYear</span>
    </div>
    <div class="col-md-5">
        <label class="form-label">@T["版本"]</label>
        <span class="text-primary">@T[Model.Version]</span>
    </div>
    <div class="col-md-5">
        <label class="form-label">@T["年级"]</label>
        <span class="text-primary">@T[Model.Grade]</span>
    </div>
    <div class="col-md-5">
        <label class="form-label">@T["学期"]</label>
        <span class="text-primary">@T[Model.Semester]</span>
    </div>
    <div class="col-md-5">
        <a href="/books/@(Model.BookId)/words" class="btn btn-outline-primary" data-mdb-ripple-init>@T["字库"]</a>
        <a href="/books/@(Model.BookId)/update" class="btn btn-outline-primary">@T["更新"]</a>
        <button @onclick="@(e => Delete())" class="btn btn-outline-danger">
            @T["删除"]
        </button>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    public BookModel Model { get; set; }
    public string[] Grades;
    public string[] Versions;
    public string[] Semesters;
    public int[] Years;

    public Info()
    {
        Grades = MetadataService.GetDefaultGrades();
        Versions = MetadataService.GetDefaultVersions();
        Semesters = MetadataService.GetDefaultSemesters();
        Years = MetadataService.GetDefaultYears();
        Model = new BookModel(new Entities.Entities.BookEntity())
            {
                BookId = id,
            };
    }

    protected override async Task OnInitializedAsync()
    {
        Model = await service.GetByIdAsync(id);
    }

    private async Task Delete()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", T["删除课本确认", Model.FriendlyName].Value))
            return;

        await service.DeleteAsync(id);
        navigationManager.NavigateTo($"/books");
    }
}