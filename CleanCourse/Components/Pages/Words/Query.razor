@page "/books/{bookId:int}/words"
@using Services.Books
@using Services.Words
@using Services.Words.Models
@using Services.Metadata
@inject IWordManageService service
@inject IBookService bookService
@inject IJSRuntime JSRuntime
@inject AppState appState
@inject NavigationManager navigationManager

<h3>@T["词条库"]</h3>

<p>
    @T["查询当前课本中的词条", Model.BookName]
    <a href="/books/@(bookId)/words/add" class="btn btn-outline-primary" data-mdb-ripple-init>@T["新增"]</a>
    <a href="/books/@(bookId)/words/import" class="btn btn-outline-primary" data-mdb-ripple-init>@T["导入"]</a>
</p>
<hr class="hr" />
<EditForm Model="@Model" OnValidSubmit="@Submit" FormName="SearchWords">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table class="row gy-3 pe-1">
        <tbody>
            <tr class="form-group">
                <td>
                    <label class="form-label">
                        @T["单元"]
                    </label>
                    <select @bind="Model.Unit" class="form-select">
                        @foreach (var unit in Units)
                        {
                            <option value="@unit.Key">@(unit.Key == 0 ? T["全部"].Value : T["第几课", unit.Value].Value)</option>
                        }
                    </select>
                </td>
                <td>
                    <label class="form-label">@T["关键字"]</label>
                    <InputText @bind-Value="Model!.Keyword" class="form-control rounded" />
                </td>
                <td>
                    <label class="form-label"></label>
                    <button type="submit" class="btn btn-primary form-control mx-3" data-mdb-ripple-init>@T["查询"]</button>
                </td>
            </tr>
        </tbody>
    </table>
</EditForm>
<hr class="hr" />
@if (result == null)
{
    <p><em>@T["加载中"]</em></p>
}
else
{
    @if (currentItems.Count == 0)
    {
        <p><em>@T["从字库下载并导入"] <a href="https://www.metadlw.com/words" class="link-primary">@T["字库"]</a> <a href="/books/@(bookId)/words/import" class="link-primary">@T["导入"]</a></em></p>
    }
    else
    {
        <table class="table">
            <thead class="thead-light">
                <tr>
                    <th>#</th>
                    <th>@T["词条"]</th>
                    <th>@T["备注"]</th>
                    <th>@T["词形扩展"]</th>
                    <th>@T["来源列"]</th>
                    <th>@T["单元"]</th>
                    <th>@T["课本列"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
           
                @{
                    var x = 1;
                }
                @foreach (var word in currentItems)
                {
                    <tr>
                        <td>@(x++)</td>
                        <td><a href="/history/@word.WordId/info" class="text-info">@word.Content</a></td>
                        <td>@word.Explanation</td>
                        <td>@string.Join("；", word.Extensions.Select(extension => $"{extension.Name}: {extension.Content}"))</td>
                        <td>@T[word.Source]</td>
                        <td>@(word.Unit == 0 ? T["全部"].Value : T["第几课", word.Unit].Value)</td>
                        <td><a href="/books/@word.BookId/info" class="text-info">@word.Book.ShortName</a></td>
                        <td>
                            <a href="/books/@bookId/words/@(word.WordId)/update" class="btn btn-outline-primary m-1">@T["更新"]</a>
                            <button @onclick="@(e => Delete(word.WordId, word.Content))" class="btn btn-outline-danger">
                                @T["删除"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    
        <nav aria-label="Page navigation example">
            <Pagination CurrentPage="@Model.PageIndex" TotalPages="@totalPage" PageChanged="ChangePage" />
        </nav>
    }
}

@code {
    [Parameter]
    public int bookId { get; set; }

    [SupplyParameterFromForm]
    public SearchWordsCriteria Model { get; set; }

    private SearchWordsResult result;

    private Dictionary<int, string> Units;

    private int totalPage;
    private int pageSize;
    private IList<WordModel> currentItems;

    public Query()
    {
        Units = MetadataService.GetDefaultUnits();
        Model = new SearchWordsCriteria()
        {
            BookId = bookId,
        };
    }

    protected override async Task OnInitializedAsync()
    {
        pageSize = appState.DefaultPageSize;
        if (bookId<=0)
        {
            navigationManager.NavigateTo("/books", true);
            return;
        }
        var book = await bookService.GetByIdAsync(bookId);
        Model.BookId = bookId;
        Model.BookName = book.BookName;
        var lastSearchCriteria = appState.SearchWordsCriteria;
        if (lastSearchCriteria?.BookId == Model.BookId)
        {
            Model = lastSearchCriteria;
        }

        result = await service.GetWordsForBookCategoryAsync(Model);
        Refresh();
    }

    private async Task Submit()
    {
        Model.PageIndex = 1;
        result = await service.GetWordsForBookCategoryAsync(Model);
        Refresh();
    }

    private async Task Delete(int id, string content)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", T["删除词条确认", content].Value))
            return;

        if (await service.DeleteWordAsync(id))
        {
            result = new SearchWordsResult()
                {
                    Words = result.Words.Where(x => x.WordId != id).ToArray(),
                    Count = result.Count - 1,
                };
            Refresh();
        }
    }

    private void Refresh()
    {
        var pageIndex = Model.PageIndex;
        totalPage = Math.Max(1, (int)Math.Ceiling(result.Count * 1.0 / pageSize));
        ChangePage(pageIndex);

        appState.SearchWordsCriteria = Model;
    }

    private void ChangePage(int pageIndex)
    {
        if (pageIndex < 1)
        {
            pageIndex = 1;
        }

        if (pageIndex > totalPage)
        {
            pageIndex = totalPage;
        }

        Model.PageIndex = pageIndex;
        currentItems = result.Words.Skip((pageIndex - 1) * pageSize).Take(pageSize).ToList();
    }
}
