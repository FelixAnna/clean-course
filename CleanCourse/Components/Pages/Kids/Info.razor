@page "/kids/{id:int}/info"
@using Services.Kids
@using Services.Kids.Models
@inject IKidService service
@inject IJSRuntime JSRuntime
@inject AppState appState
@inject NavigationManager navigationManager

<h3>@T["宝宝"]</h3>
<p>@T["宝宝信息"]</p>

<hr class="hr" />

<div class="page">
    <div class="col-md-5">
        <label class="form-label">Id：</label>
        <span class="text-primary">@Model.Id</span>
    </div>
    <div class="col-md-5">
        <label class="form-label">@T["昵称"]</label>
        <span class="text-primary">@Model.Name</span>
    </div>
    <div class="col-md-5">
        <label class="form-label">@T["默认"]</label>
        @if (Model.Selected == true)
        {
            <span class="default-dot default-dot-kid" title="@T["当前默认宝宝"]" aria-label="@T["当前默认宝宝"]"></span>
        }
        else
        {
            <span class="text-muted">@T["否"]</span>
        }
    </div>
    <div class="col-md-5">
        <a href="/kids/@(Model.Id)/update" class="btn btn-outline-primary">@T["更新"]</a>
        
        @if (Model.Selected != true)
        {
            <button type="button" @onclick="@(e => Select(Model.Id, Model.Name))" class="btn btn-set-default m-1">
                @T["设为默认"]
            </button>
            <button @onclick="@(e => Delete(Model.Id, Model.Name))" class="btn btn-outline-danger m-1">
                @T["取消登记"]
            </button>
        }
    </div>
</div>
@code {
    [Parameter]
    public int id { get; set; }

    public KidModel Model { get; set; }

    public Info()
    {
        Model = new KidModel(null)
        {
            Id = id,
        };
    }

    protected override async Task OnInitializedAsync()
    {
        Model = await service.GetByIdAsync(id);
    }

    private async Task Delete(int id, string name)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", T["取消登记宝宝确认", name].Value))
            return;

        if (await service.UnRegisterKidAsync(id))
        {
            navigationManager.NavigateTo($"/kids");
        }
    }

    private async Task Select(int id, string name)
    {
        if (await service.SetDefaultAsync(id))
        {
            appState.KidId = id;
            appState.KidName = name;

            Model.Selected = true;
        }
    }
}