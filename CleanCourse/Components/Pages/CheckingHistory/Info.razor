 @page "/history/{wordId:int}/info"
 @using Services.CheckingHistories
 @using Services.CheckingHistories.Models
 @inject ICheckingHistoryService service
 @inject IJSRuntime JSRuntime
 @inject AppState appState

 @if (historyRecords == null)
 {
     <h3>@T["检查记录"]</h3>
    <p>@T["这里显示当前词条的检查记录。"]</p>
     <hr class="hr" />
     <p><em>@T["加载中"]</em></p>
 }
 else
 {
    <h3>@historyRecords.Content</h3>
     <p>@historyRecords.Explanation</p>
     <hr class="hr" />
     <table class="row gy-3 pe-1">
        <tr class="form-group">
            <td class="col-md-5">
                <label class="form-label">@T["课程"]</label>
                <span class="text-primary"><a href="/books/@historyRecords.BookId/info" class="text-info">@GetLocalizedBookDisplayName()</a></span>
            </td>
            <td class="col-md-3">
                <label class="form-label">@T["教材"]</label>
                <span class="text-primary"><a href="/bookCategories/@(appState.BookCategoryId)/info">@appState.BookCategoryFullName</a></span>
            </td>
        </tr>
        <tr class="form-group">
            <td class="col-md-3">
                <label class="form-label">@T["来源"]</label>
                <span class="text-primary">@T[historyRecords.Source]</span>
            </td>
            <td class="col-md-3">
                <label class="form-label">@T["单元"]</label>
                <span class="text-primary">@T["第几课", historyRecords.Unit]</span>
            </td>
            <td class="col-md-2">
                <a href="/books/@historyRecords?.BookId/words/@WordId/update" class="btn btn-primary m-1">@T["更新词条"]</a>
            </td>
        </tr>
         @if (!string.IsNullOrEmpty(historyRecords.Details)){
         <tr class="form-group">
             <td class="m-2">
                 <label class="form-label">@T["详细描述"]</label>
                 <div class="text-secondary">@historyRecords.Details</div>
             </td>
         </tr>
         }
         @if (historyRecords.Extensions.Count > 0)
         {
         <tr class="form-group">
             <td class="m-2">
                 <label class="form-label">@T["词形扩展"]</label>
                 <div class="text-secondary">@string.Join("；", historyRecords.Extensions.Select(extension => $"{extension.Name}: {extension.Content}"))</div>
             </td>
         </tr>
         }
     </table>
     <hr class="hr" />
     <table class="table">
         <thead class="thead-dark">
             <tr>
                 <th scope="col">#</th>
                 <th scope="col">@T["宝宝"]</th>
                 <th scope="col">@T["结果"]</th>
                 <th scope="col">@T["备注"]</th>
                 <th scope="col">@T["记录时间"]</th>
                 <th></th>
             </tr>
         </thead>
         <tbody>
             @{
                 int x = 1;
             }
             @foreach (var history in currentItems)
             {
                 <tr>
                     <td>@(x++)</td>
                     <td>@history.Kid.Name</td>
                     <td>@(history.IsCorrect ? T["正确"].Value : T["错误"].Value)</td>
                     <td>@T[history.GetFormattedRemark()]</td>
                     <td>@history.CreatedTime</td>
                     <td>
                         <button @onclick="@(e => Delete(history.Id))" class="btn btn-outline-danger">
                             @T["删除"]
                         </button>
             <Pagination CurrentPage="@pageIndex" TotalPages="@totalPage" PageChanged="ChangePage" />
                     </td>
                 </tr>
             }
         </tbody>
     </table>

 }

 @code {
     [Parameter]
     public int WordId { get; set; }

     private Services.CheckingHistories.CheckingHistoryModel historyRecords;

     private int pageIndex;
     private int totalPage;
     private int pageSize;
     private IList<CheckingHistory> currentItems;

     protected override async Task OnInitializedAsync()
     {
         pageSize = appState.DefaultPageSize;
         historyRecords = await service.GetByWordAndKidAsync(WordId, appState.KidId);
         Refresh(1);
     }

     private async Task Delete(int id)
     {
         if (!await JSRuntime.InvokeAsync<bool>("confirm", T["检查记录详情确认删除", id].Value))
             return;

         if (await service.DeleteAsync(id))
         {
             historyRecords.Histories = historyRecords.Histories.Where(x => x.Id != id).ToArray();
             Refresh(pageIndex);
         }
     }

      private string GetLocalizedBookDisplayName()
      {
          var book = historyRecords.Book;
          return $"{T[book.Grade].Value} {T[book.BookName].Value} {T[book.Semester].Value}({T[book.Version].Value})";
      }

     private void Refresh(int page)
     {
        totalPage = Math.Max(1, (int)Math.Ceiling(historyRecords.Histories.Count() * 1.0 / pageSize));
         ChangePage(page);
     }

     private void ChangePage(int i)
     {
         if (i < 1)
         {
             i = 1;
         }

         if (i > totalPage)
         {
             i = totalPage;
         }

         pageIndex = i;
         currentItems = historyRecords.Histories.Skip((pageIndex - 1) * pageSize).Take(pageSize).ToList();
     }
 }
