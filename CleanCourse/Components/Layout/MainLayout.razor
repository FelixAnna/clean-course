@inherits LayoutComponentBase
@implements IDisposable
@inject AppLocalization Localization

<CascadingValue Value="Localization.CultureName">
    <div class="page" @key="Localization.CultureName">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</CascadingValue>

@code {
    protected override void OnInitialized()
    {
        Localization.CultureChanged += OnCultureChanged;
    }

    private void OnCultureChanged()
    {
        _ = InvokeAsync(() =>
        {
            Localization.ApplyCurrentCulture();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Localization.CultureChanged -= OnCultureChanged;
    }
}
